      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "CONFIGURAR_GSHEETS",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.id, p.nombre_completo AS paciente, p.telefono_whatsapp AS telefono_paciente, pr.nombre AS profesional, pr.especialidad, t.fecha_hora_inicio, t.estado, t.canal_reserva, t.google_event_id, t.creado_en FROM turnos t LEFT JOIN pacientes p ON t.paciente_id = p.id LEFT JOIN profesionales pr ON t.profesional_id = pr.id ORDER BY t.fecha_hora_inicio DESC",
        "options": {}
      },
      "id": "pg-turnos",
      "name": "Query Turnos (con JOINs)",
