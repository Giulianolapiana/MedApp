            "index": 0
          }
        ]
      ]
    },
    "Configuración de la clínica": {
      "main": [
        [
          {
            "node": "Agenda próximos 14 días (clínica)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agenda próximos 14 días (clínica)": {
      "main": [
        [
          {
            "node": "Sheets → Agenda",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sheets → Agenda": {
      "main": [
        [
          {
            "node": "Registrar tablero en MedApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
