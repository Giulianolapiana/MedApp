{
  "name": "MedAPP - Backup a Google Sheets (Cron Nocturno)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 23 * * *"
            }
          ]
        }
      },
      "id": "schedule-backup",
      "name": "Todas las noches a las 23:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-700, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, nombre_completo, telefono_whatsapp, email, fecha_nacimiento, activo, creado_en FROM pacientes ORDER BY creado_en DESC",
        "options": {}
      },
      "id": "pg-pacientes",
      "name": "Query Pacientes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-480, 0],
      "credentials": {
        "postgres": {
          "id": "CONFIGURAR_POSTGRES",
          "name": "Supabase PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "URL_DE_TU_SPREADSHEET_AQUI"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "Pacientes",
          "cachedResultName": "Pacientes"
