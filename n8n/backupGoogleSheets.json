{
  "name": "MedAPP - Tablero operativo de agenda (Google Sheets, nocturno)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 23 * * *"
            }
          ]
        }
      },
      "id": "schedule-backup",
      "name": "Todas las noches a las 23:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -700,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-clinica",
              "name": "clinica_id",
              "value": "9569ad65-a5fd-4692-9804-be6ae60fad76",
              "type": "string"
            },
            {
              "id": "cfg-sheet",
              "name": "planilla_url",
              "value": "https://docs.google.com/spreadsheets/d/REEMPLAZAR_ID_PLANILLA/edit",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "cfg-tablero",
      "name": "Configuración de la clínica",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -480,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.id,\n       to_char(t.fecha_hora_inicio AT TIME ZONE 'America/Argentina/Mendoza', 'YYYY-MM-DD') AS fecha,\n       to_char(t.fecha_hora_inicio AT TIME ZONE 'America/Argentina/Mendoza', 'HH24:MI') AS hora,\n       pr.nombre AS profesional,\n       p.nombre_completo AS paciente,\n       p.telefono_whatsapp AS telefono,\n       t.estado,\n       t.canal_reserva,\n       to_char(now() AT TIME ZONE 'America/Argentina/Mendoza', 'YYYY-MM-DD HH24:MI') AS actualizado\nFROM turnos t\nJOIN pacientes p ON p.id = t.paciente_id\nJOIN profesionales pr ON pr.id = t.profesional_id\nWHERE t.clinica_id = $1::uuid\n  AND t.fecha_hora_inicio >= now() - interval '1 day'\n  AND t.fecha_hora_inicio <  now() + interval '14 days'\nORDER BY t.fecha_hora_inicio",
        "options": {
          "queryReplacement": "={{ $json.clinica_id }}"
        }
      },
      "id": "q-agenda",
      "name": "Agenda próximos 14 días (clínica)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -260,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "CONFIGURAR_POSTGRES",
          "name": "Supabase PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Configuración de la clínica').item.json.planilla_url }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "Agenda",
          "cachedResultName": "Agenda"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": [
            "id"
          ]
        },
        "options": {}
      },
      "id": "gs-agenda",
      "name": "Sheets → Agenda",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -40,
        0
      ],
      "executeOnce": false,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "CONFIGURAR_GSHEETS",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.verticedev.online/api/v1/backups/registro",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ clinica_id: $('Configuración de la clínica').item.json.clinica_id, tipo_artefacto: 'tablero_agenda', tipo_ejecucion: 'automatica', estado: 'completado', archivo_url: $('Configuración de la clínica').item.json.planilla_url, detalle: `${$('Agenda próximos 14 días (clínica)').all().length} turnos exportados` }) }}",
        "options": {}
      },
      "id": "reg-tablero",
      "name": "Registrar tablero en MedApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        180,
        0
      ],
      "executeOnce": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_AL_IMPORTAR",
          "name": "MedApp API (x-api-key)"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Todas las noches a las 23:00": {
      "main": [
        [
          {
            "node": "Configuración de la clínica",
