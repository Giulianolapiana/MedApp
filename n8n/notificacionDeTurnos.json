      "id": "http-get-turnos-manana",
      "name": "Obtener Turnos de Mañana (MedAPP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-480, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_AL_IMPORTAR",
          "name": "MedApp API (x-api-key)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.first().json.data || [];\nif (!items.length) {\n  return [];\n}\nreturn items.map(turno => ({ json: turno }));"
      },
      "id": "code-split-turnos",
      "name": "Separar cada Turno",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-260, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "var-serverUrl",
              "name": "serverUrl",
              "value": "https://chatwoot.verticedev.online",
              "type": "string"
            },
            {
              "id": "var-accountId",
              "name": "accountId",
              "value": "3",
              "type": "string"
            },
            {
              "id": "var-inboxId",
              "name": "inboxId",
              "value": "6",
              "type": "string"
            },
            {
              "id": "var-nombre",
              "name": "paciente_nombre",
              "value": "={{ $json.paciente.nombre }}",
              "type": "string"
            },
            {
              "id": "var-telefono",
              "name": "paciente_telefono",
              "value": "={{ $json.paciente.telefono }}",
              "type": "string"
            },
            {
              "id": "var-medico",
              "name": "profesional_nombre",
              "value": "={{ $json.profesional.nombre }}",
              "type": "string"
            },
            {
              "id": "var-especialidad",
              "name": "especialidad",
              "value": "={{ $json.profesional.especialidad }}",
              "type": "string"
            },
            {
              "id": "var-fecha",
              "name": "fecha",
              "value": "={{ $json.fecha }}",
              "type": "string"
            },
            {
              "id": "var-hora",
              "name": "hora",
              "value": "={{ $json.hora }}",
              "type": "string"
            },
            {
              "id": "var-turno",
              "name": "turno_id",
              "value": "={{ $json.turno_id }}",
              "type": "string"
            },
            {
              "id": "var-cuando",
              "name": "cuando",
              "value": "={{ $json.cuando }}",
              "type": "string"
            },
            {
              "id": "var-chatwoot-token",
              "name": "chatwootToken",
              "value": "REEMPLAZAR_CON_TU_TOKEN_CHATWOOT",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-chatwoot-variables",
      "name": "Variables Chatwoot",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nfor (let i = 0; i < $input.all().length; i++) {\n  const item = $input.all()[i];\n  const vars = item.json;\n  const serverUrl = vars.serverUrl;\n  const accountId = vars.accountId;\n  const phone = '+' + vars.paciente_telefono.replace('+', '').replace(/\\s+/g, '');\n  const name = vars.paciente_nombre;\n  const token = vars.chatwootToken;\n\n  // 1) Search for existing contact by phone\n  let contactId = null;\n  try {\n    const searchRes = await fetch(\n      `${serverUrl}/api/v1/accounts/${accountId}/contacts/search?q=${encodeURIComponent(phone)}&include_contacts=true`,\n      { headers: { 'api_access_token': token } }\n    );\n    const searchData = await searchRes.json();\n    if (searchData.payload && searchData.payload.length > 0) {\n      const match = searchData.payload.find(c => c.phone_number === phone);\n      if (match) contactId = match.id;\n    }\n  } catch(e) { /* search failed, will try create */ }\n\n  // 2) If not found, create\n  if (!contactId) {\n    try {\n      const createRes = await fetch(\n        `${serverUrl}/api/v1/accounts/${accountId}/contacts`,\n        {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json', 'api_access_token': token },\n          body: JSON.stringify({ name, phone_number: phone })\n        }\n      );\n      const createData = await createRes.json();\n      if (createData.payload && createData.payload.contact) {\n        contactId = createData.payload.contact.id;\n      } else if (createData.id) {\n        contactId = createData.id;\n      } else {\n        // 422 duplicate — search again\n        const retry = await fetch(\n          `${serverUrl}/api/v1/accounts/${accountId}/contacts/search?q=${encodeURIComponent(phone)}`,\n          { headers: { 'api_access_token': token } }\n        );\n        const retryData = await retry.json();\n        if (retryData.payload && retryData.payload.length > 0) {\n          const match = retryData.payload.find(c => c.phone_number === phone);\n          if (match) contactId = match.id;\n        }\n      }\n    } catch(e) { /* create failed */ }\n  }\n\n  results.push({\n    json: { contact_id: contactId || 0 },\n    pairedItem: { item: i }\n  });\n}\nreturn results;"
      },
      "id": "code-buscar-o-crear-contacto",
      "name": "Buscar o Crear Contacto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [250, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Variables Chatwoot').item.json.serverUrl }}/api/v1/accounts/{{ $('Variables Chatwoot').item.json.accountId }}/contacts/{{ $json.contact_id }}/conversations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-buscar-conversaciones",
      "name": "Buscar Conversaciones",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "xzyTaKXyidm2A0tU",
          "name": "chatwoot bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  const payload = item.json.payload || [];\n  const inboxId = parseInt($('Variables Chatwoot').itemMatching(index).json.inboxId);\n  const contactId = $('Buscar o Crear Contacto').itemMatching(index).json.contact_id;\n\n  const existing = payload.find(c => c.inbox_id === inboxId && (c.status === 'open' || c.status === 'pending'));\n\n  if (existing) {\n    return { \n      json: { id: existing.id, reused: true, contact_id: contactId },\n      pairedItem: { item: index }\n    };\n  }\n  return { \n    json: { id: null, reused: false, contact_id: contactId },\n    pairedItem: { item: index }\n  };\n});"
      },
      "id": "code-resolver-conversacion",
      "name": "Resolver Conversación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.reused }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-conv-existente",
      "name": "¿Conv Existente?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1060, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Variables Chatwoot').item.json.serverUrl }}/api/v1/accounts/{{ $('Variables Chatwoot').item.json.accountId }}/conversations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contact_id\": {{ $json.contact_id }},\n  \"inbox_id\": {{ $('Variables Chatwoot').item.json.inboxId }}\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-crear-conversacion-chatwoot",
      "name": "Crear Conversación",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, 200],
