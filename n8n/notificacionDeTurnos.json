{
  "name": "MedAPP - Recordatorios de turnos",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger-recordatorios",
      "name": "Todos los días a las 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -700,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.verticedev.online/api/v1/turnos/recordatorios",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "http-get-turnos-manana",
      "name": "Obtener Turnos de Mañana (MedAPP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -480,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_AL_IMPORTAR",
          "name": "MedApp API (x-api-key)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.first().json.data || [];\nif (!items.length) {\n  return [];\n}\nreturn items.map(turno => ({ json: turno }));"
      },
      "id": "code-split-turnos",
      "name": "Separar cada Turno",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -260,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "var-serverUrl",
              "name": "serverUrl",
              "value": "https://chatwoot.verticedev.online",
              "type": "string"
            },
            {
              "id": "var-accountId",
              "name": "accountId",
              "value": "3",
              "type": "string"
            },
            {
              "id": "var-inboxId",
              "name": "inboxId",
              "value": "6",
              "type": "string"
            },
            {
              "id": "var-nombre",
              "name": "paciente_nombre",
              "value": "={{ $json.paciente.nombre }}",
              "type": "string"
            },
            {
              "id": "var-telefono",
              "name": "paciente_telefono",
              "value": "={{ $json.paciente.telefono }}",
              "type": "string"
            },
            {
              "id": "var-medico",
              "name": "profesional_nombre",
              "value": "={{ $json.profesional.nombre }}",
              "type": "string"
            },
            {
              "id": "var-especialidad",
              "name": "especialidad",
              "value": "={{ $json.profesional.especialidad }}",
              "type": "string"
            },
            {
              "id": "var-fecha",
              "name": "fecha",
              "value": "={{ $json.fecha }}",
              "type": "string"
            },
            {
              "id": "var-hora",
