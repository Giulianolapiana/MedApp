              "name": "plantilla",
              "value": "recordatorio_turno",
              "type": "string"
            },
            {
              "id": "tpl-idioma",
              "name": "plantilla_idioma",
              "value": "es_ES",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-chatwoot-variables",
      "name": "Variables Chatwoot",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -40,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.serverUrl }}/api/v1/accounts/{{ $json.accountId }}/contacts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": {{ JSON.stringify($json.paciente_nombre) }},\n  \"phone_number\": {{ JSON.stringify('+' + $json.paciente_telefono.replace('+', '').replace(/\\\\s+/g, '')) }}\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-crear-contacto",
      "name": "Crear Contacto (puede fallar)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        180,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "xzyTaKXyidm2A0tU",
          "name": "chatwoot bot"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Variables Chatwoot').item.json.serverUrl }}/api/v1/accounts/{{ $('Variables Chatwoot').item.json.accountId }}/contacts/search?q={{ encodeURIComponent('+' + $('Variables Chatwoot').item.json.paciente_telefono.replace('+', '').replace(/\\s+/g, '')) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-buscar-contacto-telefono",
      "name": "Buscar Contacto por Teléfono",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "xzyTaKXyidm2A0tU",
          "name": "chatwoot bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  const searchResults = item.json.payload || [];\n  const phone = '+' + $('Variables Chatwoot').itemMatching(index).json.paciente_telefono.replace('+', '').replace(/\\s+/g, '');\n  const match = searchResults.find(c => c.phone_number === phone);\n  return {\n    json: { contact_id: match ? match.id : 0 },\n    pairedItem: { item: index }\n  };\n});"
      },
      "id": "code-extraer-contact-id",
      "name": "Extraer Contact ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Variables Chatwoot').item.json.serverUrl }}/api/v1/accounts/{{ $('Variables Chatwoot').item.json.accountId }}/contacts/{{ $json.contact_id }}/conversations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-buscar-conversaciones",
      "name": "Buscar Conversaciones",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        620,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "xzyTaKXyidm2A0tU",
          "name": "chatwoot bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  const payload = item.json.payload || [];\n  const inboxId = parseInt($('Variables Chatwoot').itemMatching(index).json.inboxId);\n  const contactId = $('Extraer Contact ID').itemMatching(index).json.contact_id;\n\n  const existing = payload.find(c => c.inbox_id === inboxId && (c.status === 'open' || c.status === 'pending'));\n\n  if (existing) {\n    return { \n      json: { id: existing.id, reused: true, contact_id: contactId },\n      pairedItem: { item: index }\n    };\n  }\n  return { \n    json: { id: null, reused: false, contact_id: contactId },\n    pairedItem: { item: index }\n  };\n});"
      },
      "id": "code-resolver-conversacion",
      "name": "Resolver Conversación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.reused }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-conv-existente",
      "name": "¿Conv Existente?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1060,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Variables Chatwoot').item.json.serverUrl }}/api/v1/accounts/{{ $('Variables Chatwoot').item.json.accountId }}/conversations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contact_id\": {{ $json.contact_id }},\n  \"inbox_id\": {{ $('Variables Chatwoot').item.json.inboxId }}\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-crear-conversacion-chatwoot",
      "name": "Crear Conversación",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "xzyTaKXyidm2A0tU",
          "name": "chatwoot bot"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Variables Chatwoot').item.json.serverUrl }}/api/v1/accounts/{{ $('Variables Chatwoot').item.json.accountId }}/conversations/{{ $json.id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  content: `Hola ${$('Variables Chatwoot').item.json.paciente_nombre} 👋 Te recordamos tu turno en MedAPP con ${$('Variables Chatwoot').item.json.profesional_nombre} (${$('Variables Chatwoot').item.json.especialidad}) el ${$('Variables Chatwoot').item.json.cuando}.\\nRespondé CONFIRMAR para confirmar, CANCELAR si no podés asistir o CAMBIAR si querés otro horario.`,\n  message_type: 'outgoing',\n  private: false,\n  template_params: {\n    name: $('Variables Chatwoot').item.json.plantilla,\n    category: 'UTILITY',\n    language: $('Variables Chatwoot').item.json.plantilla_idioma,\n    processed_params: {\n      body: {\n        '1': $('Variables Chatwoot').item.json.paciente_nombre,\n        '2': $('Variables Chatwoot').item.json.profesional_nombre,\n        '3': $('Variables Chatwoot').item.json.especialidad,\n        '4': $('Variables Chatwoot').item.json.cuando\n      },\n      '1': $('Variables Chatwoot').item.json.paciente_nombre,\n      '2': $('Variables Chatwoot').item.json.profesional_nombre,\n      '3': $('Variables Chatwoot').item.json.especialidad,\n      '4': $('Variables Chatwoot').item.json.cuando\n    }\n  }\n}) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": false
            }
          }
        }
      },
      "id": "http-enviar-recordatorio",
      "name": "Enviar WhatsApp Recordatorio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "xzyTaKXyidm2A0tU",
          "name": "chatwoot bot"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.verticedev.online/api/v1/turnos/recordatorios/{{ $('Variables Chatwoot').item.json.turno_id }}/enviado",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ mensaje_externo_id: String($json.id), estado: 'enviado' }) }}",
        "options": {}
      },
      "id": "http-registrar-recordatorio",
      "name": "Registrar Envío en MedApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1940,
        -100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_AL_IMPORTAR",
          "name": "MedApp API (x-api-key)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ !!$json.id && !$json.error }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-aceptado",
      "name": "¿Chatwoot aceptó el envío?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.verticedev.online/api/v1/turnos/recordatorios/{{ $('Variables Chatwoot').item.json.turno_id }}/enviado",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ estado: 'fallido', detalle: String($json.error?.message || $json.message || 'envío rechazado').slice(0, 500) }) }}",
        "options": {}
      },
      "id": "http-registrar-fallo",
      "name": "Registrar fallo (permite reintento)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1940,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_AL_IMPORTAR",
          "name": "MedApp API (x-api-key)"
        }
      }
    }
  ],
