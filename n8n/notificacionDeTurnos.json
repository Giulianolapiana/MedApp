    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Variables Chatwoot').item.json.serverUrl }}/api/v1/accounts/{{ $('Variables Chatwoot').item.json.accountId }}/conversations/{{ $json.id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  content: `Hola ${$('Variables Chatwoot').item.json.paciente_nombre} 👋 Te recordamos tu turno en MedAPP con ${$('Variables Chatwoot').item.json.profesional_nombre} (${$('Variables Chatwoot').item.json.especialidad}) el ${$('Variables Chatwoot').item.json.cuando}.\\n\\nRespondé CONFIRMAR para confirmar, CANCELAR si no podés asistir o CAMBIAR si querés otro horario.`,\n  message_type: 'outgoing',\n  private: false\n}) }}",
        "options": {}
      },
