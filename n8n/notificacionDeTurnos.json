      "id": "830ec105-8226-4a7e-9c88-45417b90c022",
      "name": "Buscar Contacto por Teléfono",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -4560,
        944
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "xzyTaKXyidm2A0tU",
          "name": "chatwoot bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  const searchResults = item.json.payload || [];\n  const phone = '+' + $('Variables Chatwoot').itemMatching(index).json.paciente_telefono.replace('+', '').replace(/\\s+/g, '');\n  const match = searchResults.find(c => c.phone_number === phone);\n  return {\n    json: { contact_id: match ? match.id : 0 },\n    pairedItem: { item: index }\n  };\n});"
      },
      "id": "bb2efc39-e27a-450f-86c6-288c960e4ca5",
      "name": "Extraer Contact ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -4336,
        944
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Variables Chatwoot').item.json.serverUrl }}/api/v1/accounts/{{ $('Variables Chatwoot').item.json.accountId }}/contacts/{{ $json.contact_id }}/conversations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "6078b81b-0be3-44ea-b355-80959e618378",
      "name": "Buscar Conversaciones",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -4096,
        944
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "xzyTaKXyidm2A0tU",
          "name": "chatwoot bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  const payload = item.json.payload || [];\n  const inboxId = parseInt($('Variables Chatwoot').itemMatching(index).json.inboxId);\n  const contactId = $('Extraer Contact ID').itemMatching(index).json.contact_id;\n\n  const existing = payload.find(c => c.inbox_id === inboxId && (c.status === 'open' || c.status === 'pending'));\n\n  if (existing) {\n    return { \n      json: { id: existing.id, reused: true, contact_id: contactId },\n      pairedItem: { item: index }\n    };\n  }\n  return { \n    json: { id: null, reused: false, contact_id: contactId },\n    pairedItem: { item: index }\n  };\n});"
      },
      "id": "3a5c908e-c4eb-4082-a66c-efb5cc03240b",
      "name": "Resolver Conversación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -4608,
        1312
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.reused }}",
              "value2": true
            }
          ]
        }
      },
