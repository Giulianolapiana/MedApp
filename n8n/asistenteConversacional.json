    {
      "parameters": {
        "jsCode": "// A2-03: el webhook no se toma como fuente de verdad. Cada evento se confirma\n// consultando a Chatwoot con credenciales propias: el mensaje debe existir en esa\n// conversación, ser entrante, coincidir en contenido y pertenecer a la bandeja\n// configurada. El teléfono se toma de Chatwoot, no del cuerpo del webhook.\nconst body = $('Webhook').first().json.body || {};\nconst cfg = $('Configuración').first().json;\nconst conv = $('Chatwoot: conversación').first().json || {};\nconst msgs = ($('Chatwoot: mensajes').first().json || {}).payload || [];\nconst m = msgs.find(x => String(x.id) === String(body.id));\nconst telefono = conv?.meta?.sender?.phone_number || '';\nconst valido = !!m && m.message_type === 0 && (m.content || '') === (body.content || '')\n  && Number(conv.inbox_id) === Number(cfg.inboxId) && !!telefono;\nreturn [{ json: { valido, telefono, contenido: m ? m.content : '', usuario: conv?.meta?.sender?.name || '',\n  conversacion_id: conv.id, motivo: valido ? 'ok' : 'evento no verificado en Chatwoot' } }];"
      },
      "id": "cd3f445e-cfa4-4206-8ebe-6678d6f0c2ba",
      "name": "¿Mensaje auténtico?",
