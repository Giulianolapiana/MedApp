              "value1": "={{ $json.body.event === 'message_updated' && $json.body.message_type === 'outgoing' && ['sent','delivered','read','failed'].includes($json.body.status) }}",
              "value2": true
            }
          ]
        }
      },
      "id": "bb0af793-3694-4293-9c08-131840feacac",
