    {
      "parameters": {
        "jsCode": "// M3-01: el estado de entrega tampoco se toma del webhook. Se confirma en Chatwoot\n// que el mensaje exista en esa conversación, sea saliente (message_type 1) y pertenezca\n// a la bandeja del consultorio; el estado que se registra es el que informa Chatwoot.\nconst body = $('Webhook').first().json.body || {};\nconst cfg = $('Configuración (estado)').first().json;\nconst conv = $('Chatwoot: conversación (estado)').first().json || {};\nconst msgs = ($('Chatwoot: mensajes (estado)').first().json || {}).payload || [];\nconst m = msgs.find(x => String(x.id) === String(body.id));\nconst mapa = { sent: 'enviado', delivered: 'entregado', read: 'leido', failed: 'fallido' };\nconst valido = !!m && m.message_type === 1 && Number(conv.inbox_id) === Number(cfg.inboxId) && !!mapa[m.status];\nreturn [{ json: { valido, mensaje_externo_id: m ? String(m.id) : null, estado: m ? mapa[m.status] : null,\n  detalle: m?.content_attributes?.external_error || null, motivo: valido ? 'ok' : 'estado no verificado en Chatwoot' } }];"
      },
